{
  "description": "P006 反应骰 NoiseScope — 工程骨架（T001）。仅占位壳，不含 SSA、CME 或正式界面。",
  "name": "noisescope",
  "private": true,
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "vitest run",
    "test:core": "vitest run tests/core",
    "test:e2e": "npm run build && playwright test",
    "bench": "tsx scripts/bench.ts",
    "serve": "node scripts/serve.mjs dist 4173",
    "release": "node scripts/release.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "version": "0.1.0",
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  }
}
